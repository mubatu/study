{
  "name": "study-timer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build && npm run db:migrate:local && wrangler pages dev dist --port 5173",
    "dev:ui": "vite",
    "build": "tsc -b tsconfig.app.json tsconfig.functions.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b tsconfig.app.json tsconfig.functions.json",
    "db:migrate:local": "wrangler d1 migrations apply study --local",
    "db:migrate:production": "wrangler d1 migrations apply DB --remote",
    "pages:dev": "npm run dev",
    "deploy": "npm run build && wrangler pages deploy dist"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "vite": "^6.3.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250607.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "jsdom": "^26.1.0",
    "typescript": "~5.8.3",
    "vitest": "^3.2.3",
    "wrangler": "^4.19.1"
  }
}
